[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[packages]
beautifulsoup4 = "*"
click = "*"
click-didyoumean = "*"
fake-useragent = "*"
peewee = "*"
requests = "*"
rich = "*"
rich-click = "*"
structlog = "*"

[dev-packages]
mypy = "*"
pytest = "*"
pytest-cov = "*"
pytest-mock = "*"
pytest-xdist = "*"

[scripts]
# CLI
scraper = "python -m src.cli"
demo = "python -m src.cli demo"

# Testing
test = "pytest tests/unit/ -v"
test-all = "pytest tests/ -v"
test-integration = "pytest tests/integration/ -v"
test-unit = "pytest tests/unit/ -v"

# Coverage
coverage = "pytest tests/unit/ --cov=src --cov-report=term-missing"
coverage-all = "pytest tests/ --cov=src --cov-report=term-missing"
coverage-html = "pytest tests/unit/ --cov=src --cov-report=html"

# Type checking
typecheck = "mypy src/"

# Quick checks
check = "bash -c 'pytest tests/unit/ -v'"
check-fast = "pytest tests/unit/ -x"

# Parallel execution (fast)
test-parallel = "pytest tests/unit/ -n auto"

# Local development server
serve = "python scripts/serve_local.py"
serve-port = "python scripts/serve_local.py --port"

# Database validation
validate = "python -m src.cli validate"
verify-samples = "python -m src.cli verify-samples"
validate-db = "python scripts/validate_database.py"

[requires]
python_version = "3.12"
